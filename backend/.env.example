# backend/.env.example
# Template of the backend environment variables. Copy it to backend/.env and
# replace the placeholders with real values. Never commit the real .env file.

PORT=4000
NODE_ENV=development
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/explorar-ambiente
# At least 32 characters. Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Must be different from JWT_SECRET. Losing it invalidates all password hashes.
PASSWORD_PEPPER=replace-with-another-long-random-string
CLIENT_URL=http://localhost:5173
RESEND_API_KEY=re_xxxxxxxxxxxx
# Reverse proxies in front of the API: 0 locally. In production the requests go through
# Vercel and then Render, and the right number is checked after the first deploy.
TRUST_PROXY_HOPS=0